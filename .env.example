# ga4-gtm-config-mcp — environment configuration.
# Copy to `.env` (gitignored) and fill in. Never commit real values.

# --- Runtime authentication -----------------------------------------------
# The MCP runtime accepts service-account JSON, external-account/WIF JSON, or
# explicitly enabled impersonated ADC. It intentionally rejects plain
# `authorized_user` ADC files so a human user's refresh token is never used as
# the MCP operating credential.
# This authenticates the runtime identity; it does not grant GA4/GTM product
# access by itself. Run bootstrap:access first unless access was granted already.
# Set this to a real credential JSON path in the MCP host or launching shell.
GOOGLE_APPLICATION_CREDENTIALS=

# Leave unset for local JSON credentials. Set to "1" only for trusted runtimes
# where Google metadata-server credentials are the intended service identity.
ALLOW_GOOGLE_METADATA_AUTH=

# Set to "1" only when GOOGLE_APPLICATION_CREDENTIALS points to ADC with
# top-level "type": "impersonated_service_account", generated with
# `gcloud auth application-default login --impersonate-service-account=...`.
ALLOW_GOOGLE_IMPERSONATED_ADC=

# A one-time admin OAuth access token may be pasted into `npm run bootstrap:access`
# to grant this service account GA4/GTM product access through official APIs.
# Never put that token, a refresh token, or OAuth client secret in this file.

# --- Publish opt-in -------------------------------------------------------
# The publish OAuth scope cannot even be requested unless this is exactly "1".
# This is a separate decision from the per-call approval_token, with its own audit
# trail. Leave unset (or anything other than "1") to keep publishing impossible.
INCLUDE_PUBLISH_SCOPE=

# --- Target IDs -----------------------------------------------------------
# There is intentionally no GA4_PROPERTY_ID / GTM_ACCOUNT_ID here. Target IDs are
# passed as explicit tool arguments (and live in the mcp-execution.yaml spec), never
# read from the environment.
