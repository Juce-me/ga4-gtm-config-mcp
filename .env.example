# ga4-gtm-config-mcp — environment configuration.
# Copy to `.env` (gitignored) and fill in. Never commit real values.

# --- Authentication -------------------------------------------------------
# Only the service-account / Application Default Credentials path is wired today.
# `google.auth.GoogleAuth` picks this up automatically. Point it at a service-account
# JSON key whose identity has GA4 Admin (edit) and GTM (edit) access on the target
# property and container.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json

# The OAuth refresh-token flow (GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET /
# GOOGLE_REFRESH_TOKEN) is NOT constructed by the server yet — see
# src/auth/googleAuth.ts. These variables are read by nothing today; leave them
# out until the OAuth path is wired.

# --- Publish opt-in -------------------------------------------------------
# The publish OAuth scope cannot even be requested unless this is exactly "1".
# This is a separate decision from the per-call approval_token, with its own audit
# trail. Leave unset (or anything other than "1") to keep publishing impossible.
INCLUDE_PUBLISH_SCOPE=

# --- Target IDs -----------------------------------------------------------
# There is intentionally no GA4_PROPERTY_ID / GTM_ACCOUNT_ID here. Target IDs are
# passed as explicit tool arguments (and live in the mcp-execution.yaml spec), never
# read from the environment.
