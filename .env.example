# ga4-gtm-config-mcp — environment configuration.
# Copy to `.env` (gitignored) only if your launcher loads it. Never commit real values.

# Absolute path to the downloaded Google OAuth Desktop client JSON.
GOOGLE_OAUTH_CLIENT_SECRETS=/absolute/path/to/private/google-oauth-client.json

# Absolute destination for the refresh-token record created by `npm run login`.
# Login creates private parent directories and stores the file with mode 0600.
GOOGLE_OAUTH_TOKEN_PATH=/absolute/path/to/private/google-oauth-token.json

# Login always requests the complete GA4/GTM read, write, version, and publish
# scope set. This flag does not acquire scopes; it only permits the runtime to
# attempt publish-mode operations. Leave unset unless publishing is approved.
INCLUDE_PUBLISH_SCOPE=

# GA4/GTM target IDs are explicit tool arguments and spec fields, not env vars.
